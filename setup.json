{
  "id": "ACME.Dash",
  "name": "ACME Data Dash",
  "version": "0.2.0",
  "publisher": "ACME Inc. (fictional)",
  "group": "ACME Inc",
  "icon": "icon/app.ico",
  "files": [
    {"from": "target/release/acme-dash.exe"},
    {"from": "www", "to": "www"}
  ],
  "exclude": [".gitignore"],
  "run": {"program": "acme-dash.exe"},
  "askFolder": true,
  "shortcuts": {"ask": true, "startMenu": true, "desktop": false},
  "purge": ["{localappdata}\\ACME Inc\\ACME.Dash"],
  "output": "dist/{name}-{version}-setup.exe"
}
